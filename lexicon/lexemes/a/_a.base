filters:
  and:
    - "!file.name.isEmpty()"
properties:
  file.name:
    displayName: Word
  note.contributors:
    displayName: Contributors
  note.englishGloss:
    displayName: English Gloss
  note.partSpeech:
    displayName: Part of Speech
views:
  - type: table
    name: Table
    filters:
      and:
        - file.path.startsWith("lexicon/lexemes/a/")
        - file.ext == "md"
        - and:
            - "!englishGloss.isEmpty()"
    order:
      - file.name
      - partSpeech
      - englishGloss
      - contributors
    sort:
      - property: partSpeech
        direction: ASC
      - property: file.name
        direction: ASC
    columnSize:
      note.partSpeech: 134
      note.englishGloss: 967
    imageFit: ""
